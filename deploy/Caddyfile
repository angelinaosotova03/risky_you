{$DOMAIN:localhost} {
	encode zstd gzip

	# Всё, что начинается с /api, уходит в FastAPI
	handle /api/* {
		reverse_proxy api:8000
	}

	# Остальное — собранный фронтенд; неизвестные пути отдают index.html,
	# чтобы работали адреса вида /test/balloon
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
